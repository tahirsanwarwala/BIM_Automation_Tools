<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG_LEVEL" Height="700" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" ShowInTaskbar="False" Topmost="False"
        SizeToContent="Manual">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="hint">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="20,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="problem">
            <Setter Property="Foreground" Value="#B00020"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Every value the Wall Limits tool decides for itself is yours to set here. The defaults ARE Wall Limits, so a run you do not change behaves exactly as that tool does."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <GroupBox Header="Elements">
                    <StackPanel>
                        <TextBlock Style="{StaticResource hint}" Margin="0,0,0,6"
                                   Text="Unticking a category leaves it out of the run altogether - nothing about it is read or written."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="select_all" Content="All"
                                    Width="60" Margin="0,0,6,0"
                                    Click="select_all_click"/>
                            <Button x:Name="select_none" Content="None"
                                    Width="60" Click="select_none_click"/>
                        </StackPanel>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1"
                                Padding="6">
                            <ScrollViewer MaxHeight="150"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="category_list"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="What this run does">
                    <StackPanel>
                        <CheckBox x:Name="fix_constraints"
                                  FontWeight="Bold"
                                  Content="Check constraints"
                                  Checked="on_change" Unchecked="on_change"/>
                        <TextBlock Style="{StaticResource hint}"
                                   Text="Applies to every category ticked above. A WALL has its base and top rebound to its levels, is split where it crosses one, has its ends rounded, and is stopped under a floor it runs into - everything below. ANY OTHER level-based element is re-pointed at the level immediately below it, with its offset adjusted so it does not move; an element whose level cannot be paired with an offset is left alone and listed."/>
                        <TextBlock Style="{StaticResource hint}"
                                   Text="Untick it to write the level name ONLY, taken from the base each element already sits on, and change no constraint anywhere."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Constraints">
                    <StackPanel>
                        <CheckBox x:Name="split_walls"
                                  Content="Split a wall that crosses a level into one wall per storey"
                                  Checked="on_change" Unchecked="on_change"/>

                        <CheckBox x:Name="split_curtain_walls"
                                  Content="Split curtain walls at levels too"
                                  Checked="on_change" Unchecked="on_change"/>
                        <TextBlock Style="{StaticResource hint}"
                                   Text="Off leaves a curtain wall's base bound to its level and its top an unconnected height, and never cuts it. On, each storey above the first is built fresh from the wall type, so grid lines and mullions placed by hand above the cut are lost."/>

                        <CheckBox x:Name="guard_inserts"
                                  Content="Do not split when a door or insert sits above the first storey"
                                  Checked="on_change" Unchecked="on_change"/>
                        <TextBlock Style="{StaticResource hint}"
                                   Text="Such a wall keeps its corrected constraints and is reported as To Check, to be cut by hand. Turning this off lets the cut destroy them."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Rounding">
                    <StackPanel>
                        <CheckBox x:Name="round_ends"
                                  Content="Round ends that are not on a level"
                                  Checked="on_change" Unchecked="on_change"/>

                        <StackPanel Orientation="Horizontal" Margin="20,4,0,4">
                            <TextBlock Text="to the nearest" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox x:Name="round_increment" Width="90"
                                      SelectionChanged="on_change"/>
                        </StackPanel>

                        <CheckBox x:Name="round_sketched"
                                  Content="Round walls with a sketched elevation profile too"
                                  Checked="on_change" Unchecked="on_change"/>
                        <TextBlock Style="{StaticResource hint}"
                                   Text="A sketched outline travels with the end it was drawn against. Off leaves those walls exactly where they are; on treats an end off the increment as the defect it is."/>

                        <TextBlock x:Name="rounding_problem"
                                   Style="{StaticResource problem}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Floors">
                    <StackPanel>
                        <CheckBox x:Name="stop_at_floors"
                                  Content="Stop a wall at the underside of a floor it runs into"
                                  Checked="on_change" Unchecked="on_change"/>
                        <TextBlock Style="{StaticResource hint}"
                                   Text="Each storey of the wall stops under the first slab above it, bound to the level above with a negative offset - not attached to the floor. A sloped slab stops the wall at its lowest point. A wall meeting a slab within an inch of its own base is left alone and reported."/>
                        <TextBlock Style="{StaticResource hint}" Margin="20,4,0,2"
                                   Text="Look for floors in:"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1"
                                Padding="6" Margin="20,0,0,0">
                            <ScrollViewer MaxHeight="110"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="floor_source_list"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="floor_problem"
                                   Style="{StaticResource problem}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Levels">
                    <StackPanel>
                        <CheckBox x:Name="snap_to_levels"
                                  Content="Leave an end alone when it is nearly on a level"
                                  Checked="on_change" Unchecked="on_change"/>
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="An end within" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox x:Name="level_match_tol" Width="90"
                                      SelectionChanged="on_change"/>
                            <TextBlock Text="of a level is on it"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource hint}"
                                   Text="Off rounds a near-level end by the increment like any other. An end sitting exactly on a level is left alone either way - a level need not fall on a whole inch, and rounding a wall off one it is already on would invent work."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Level name">
                    <StackPanel>
                        <CheckBox x:Name="write_bg_level"
                                  Content="Write the base level's name into a parameter"
                                  Checked="on_change" Unchecked="on_change"/>
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="Parameter" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="bg_level_param" Width="220"
                                     TextChanged="on_change"/>
                        </StackPanel>
                        <TextBlock x:Name="param_problem"
                                   Style="{StaticResource problem}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="category_problem"
                   Style="{StaticResource problem}" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="reset" Content="Reset to defaults" Width="130"
                    Margin="0,0,6,0" Click="reset_click"/>
            <Button x:Name="cancel" Content="Cancel" Width="80"
                    Margin="0,0,6,0" Click="cancel_click"/>
            <Button x:Name="run" Content="Run" Width="80" IsDefault="True"
                    Click="run_click"/>
        </StackPanel>
    </Grid>
</Window>
